{
  "schemaVersion": 1,
  "id": "quickshell.tidal",
  "name": "TIDAL",
  "version": "0.8.4",
  "author": "ph0bos",
  "description": "Hi-res lossless TIDAL inside the Omarchy shell — 24-bit/192kHz FLAC, a personalised home page, artist and album pages, synced lyrics, and a mini player in the bar.",
  "kinds": [
    "service",
    "bar-widget",
    "overlay"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "qml/Service.qml",
    "barWidget": "qml/BarWidget.qml",
    "overlay": "qml/Overlay.qml"
  },
  "barWidget": {
    "displayName": "TIDAL",
    "description": "TIDAL now-playing with transport controls and stream quality",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "showQualityBadge": false,
      "maxLabelWidth": 260,
      "scrollLongLabels": true,
      "showLabel": true,
      "hideWhenPaused": false
    },
    "schema": [
      {
        "key": "showLabel",
        "type": "bool",
        "label": "Show track title"
      },
      {
        "key": "showQualityBadge",
        "type": "bool",
        "label": "Show quality badge"
      },
      {
        "key": "maxLabelWidth",
        "type": "int",
        "label": "Max label width (px)"
      },
      {
        "key": "scrollLongLabels",
        "type": "bool",
        "label": "Scroll long titles"
      },
      {
        "key": "hideWhenPaused",
        "type": "bool",
        "label": "Hide when paused"
      }
    ]
  },
  "license": "MIT",
  "repository": "https://github.com/ph0bos/omarchy-tidal"
}
